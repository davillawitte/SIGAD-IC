FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["backend/TemplateSistema.sln", "backend/"]
COPY ["backend/src/Domain/TemplateSistema.Domain.csproj", "backend/src/Domain/"]
COPY ["backend/src/Application/TemplateSistema.Application.csproj", "backend/src/Application/"]
COPY ["backend/src/Infrastructure/TemplateSistema.Infrastructure.csproj", "backend/src/Infrastructure/"]
COPY ["backend/src/Persistence/TemplateSistema.Persistence.csproj", "backend/src/Persistence/"]
COPY ["backend/src/Api/TemplateSistema.Api.csproj", "backend/src/Api/"]
COPY ["backend/Directory.Build.props", "backend/"]
COPY ["backend/global.json", "backend/"]

RUN dotnet restore "backend/src/Api/TemplateSistema.Api.csproj"

COPY backend/ backend/
WORKDIR /src/backend/src/Api
RUN dotnet publish "TemplateSistema.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
EXPOSE 8080


# fontconfig + DejaVu: sem eles o SkiaSharp (usado pelo QuestPDF pra gerar os PDFs de escala)
# cai num fallback de fonte incompleto nesta imagem Debian mínima — sintoma visto em produção:
# sequências como "ti" somem do texto ("Instituto" virava "Instuto", "Criminalística" virava
# "Criminalísca"), porque o fallback não resolve corretamente esses glifos/ligaduras.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl fontconfig fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Docker

COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "TemplateSistema.Api.dll"]
