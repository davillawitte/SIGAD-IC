# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
#
# O arquivo .env NÃO é versionado (.gitignore). Use-o só na sua máquina.
# No CI, configure o secret NODE_AUTH_TOKEN no GitHub Actions.
#
# Produção (máquina com IP público/LAN): use .env.prod.example → .env.prod
#   e ./scripts/docker-up-prod.sh  (ver docs/deploy-prod.md)

# Backend — Production (sobrescreva via variáveis de ambiente)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=gestao_ic;Username=postgres;Password=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestao_ic
DB_USER=postgres
DB_PASSWORD=

# Frontend / Docker — GitHub Packages (design system)
# Crie um PAT em https://github.com/settings/tokens com escopo read:packages
NODE_AUTH_TOKEN=

# Produção (referência — preferir .env.prod)
# APP_ORIGIN=http://10.9.233.98
# JWT_KEY=
