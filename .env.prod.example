# Produção — copie para .env.prod e preencha os valores:
#   cp .env.prod.example .env.prod
#
# O arquivo .env.prod NÃO é versionado. Use-o só na máquina de produção.
#
# Coexistência com gestao-SCFA (mesma máquina):
#   SCFA  → http://10.9.233.98/        (porta 80 — não alteramos o SCFA)
#   SIGAD → http://10.9.233.98:8080/   (nginx de borda)

# Origem pública do SIGAD (CORS + documentação)
APP_ORIGIN=http://10.9.233.98:8080

# Porta pública do nginx de borda do SIGAD (não use 80 enquanto o SCFA a ocupar)
EDGE_HTTP_PORT=8080

# Hosts aceitos pela API (separados por ;)
ALLOWED_HOSTS=10.9.233.98;localhost;127.0.0.1

# Postgres (interno ao Docker; não publicado no host)
DB_NAME=gestao_ic
DB_USER=postgres
DB_PASSWORD=altere_esta_senha_forte

# JWT — gere uma chave aleatória com >= 32 caracteres, por exemplo:
#   openssl rand -base64 48
JWT_ISSUER=sigad-ic
JWT_AUDIENCE=sigad-ic-frontend
JWT_KEY=
JWT_EXPIRATION_MINUTES=480

# GitHub Packages (design system) — PAT com escopo read:packages
NODE_AUTH_TOKEN=
